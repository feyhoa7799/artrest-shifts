# Install as /etc/artrest-supabase-backup.env with mode 0600.
# Never commit real credentials or the Restic password.

RESTIC_REPOSITORY=s3:https://s3.twcstorage.ru/CHANGE_ME_BUCKET
RESTIC_PASSWORD_FILE=/etc/artrest-supabase-backup.password
RESTIC_CACHE_DIR=/var/backups/artrest-supabase/.restic-cache

AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=ru-1

SUPABASE_DB_CONTAINER=supabase-db
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_CONFIG_DIR=/opt/artrest-supabase
BACKUP_WORK_DIR=/var/backups/artrest-supabase
