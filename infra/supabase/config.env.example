# Copy the official docker/.env.example first. These values document the
# Art Rest-specific overrides. Do not commit the resulting .env file.

# Bind the API gateway to loopback. nginx will be the only public entry point.
API_GW_HTTP_PORT=127.0.0.1:54321

SUPABASE_PUBLIC_URL=https://supabase.podrabotka.art-rest.com
API_EXTERNAL_URL=https://supabase.podrabotka.art-rest.com/auth/v1
SITE_URL=https://podrabotka.art-rest.com
ADDITIONAL_REDIRECT_URLS=https://podrabotka.art-rest.com/**

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000

DISABLE_SIGNUP=false
JWT_EXPIRY=3600

# Generate unique values with the official Supabase scripts.
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME
DASHBOARD_USERNAME=CHANGE_ME
DASHBOARD_PASSWORD=CHANGE_ME
PG_META_CRYPTO_KEY=CHANGE_ME
SECRET_KEY_BASE=CHANGE_ME
VAULT_ENC_KEY=CHANGE_ME

# Reuse the approved production SMTP provider only after its processing
# location and agreement have been checked. Do not put values in Git.
SMTP_ADMIN_EMAIL=CHANGE_ME
SMTP_HOST=CHANGE_ME
SMTP_PORT=CHANGE_ME
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SENDER_NAME=Арт Рест

